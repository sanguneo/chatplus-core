{
  "components": {
    "schemas": {
      "Capabilities": {
        "description": "No send, history completeness, attachments or stream claims.",
        "properties": {
          "features": {
            "default": [
              "rooms.read",
              "messages.read",
              "messages.stream"
            ],
            "items": {
              "type": "string"
            },
            "title": "Features",
            "type": "array"
          },
          "mode": {
            "const": "read-only",
            "default": "read-only",
            "title": "Mode",
            "type": "string"
          },
          "ok": {
            "const": true,
            "default": true,
            "title": "Ok",
            "type": "boolean"
          },
          "provider": {
            "const": "chatplus",
            "default": "chatplus",
            "title": "Provider",
            "type": "string"
          }
        },
        "title": "Capabilities",
        "type": "object"
      },
      "ErrorDetail": {
        "description": "A stable error code and a non-sensitive explanation.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "Failure": {
        "description": "The shared failure envelope.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "ok": {
            "const": false,
            "default": false,
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "error"
        ],
        "title": "Failure",
        "type": "object"
      },
      "Message": {
        "description": "Cached text, without claiming full rich-message or delivery coverage.",
        "properties": {
          "contentType": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contenttype"
          },
          "directionRaw": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Directionraw"
          },
          "hasAttachment": {
            "default": false,
            "title": "Hasattachment",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "roomId": {
            "title": "Roomid",
            "type": "string"
          },
          "sentAt": {
            "format": "date-time",
            "title": "Sentat",
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "required": [
          "id",
          "roomId",
          "text",
          "sentAt",
          "directionRaw"
        ],
        "title": "Message",
        "type": "object"
      },
      "Messages": {
        "description": "Newest cached records, returned in ascending timestamp and ID order.",
        "properties": {
          "coverage": {
            "const": "local-cache",
            "default": "local-cache",
            "title": "Coverage",
            "type": "string"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "title": "Messages",
            "type": "array"
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          },
          "ok": {
            "const": true,
            "default": true,
            "title": "Ok",
            "type": "boolean"
          },
          "order": {
            "const": "timestamp-id",
            "default": "timestamp-id",
            "title": "Order",
            "type": "string"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          },
          "truncated": {
            "title": "Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "messages",
          "total",
          "truncated"
        ],
        "title": "Messages",
        "type": "object"
      },
      "Room": {
        "description": "An opaque local room identity and the cached room name.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "title": "Room",
        "type": "object"
      },
      "Rooms": {
        "description": "A bounded list from this local cache read.",
        "properties": {
          "coverage": {
            "const": "local-cache",
            "default": "local-cache",
            "title": "Coverage",
            "type": "string"
          },
          "ok": {
            "const": true,
            "default": true,
            "title": "Ok",
            "type": "boolean"
          },
          "rooms": {
            "items": {
              "$ref": "#/components/schemas/Room"
            },
            "title": "Rooms",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          },
          "truncated": {
            "title": "Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "rooms",
          "total",
          "truncated"
        ],
        "title": "Rooms",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "ChatPlus local core",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/capabilities": {
      "get": {
        "operationId": "capabilities_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Method Not Allowed"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Client Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Capabilities"
      }
    },
    "/messages": {
      "get": {
        "operationId": "messages_messages_get",
        "parameters": [
          {
            "in": "query",
            "name": "roomId",
            "required": true,
            "schema": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Roomid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 4096,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Messages"
