# chatplus-core configuration. Copy to .env (gitignored) and fill in.
# The token the client sends on every request but /health (32+ bytes).
CHATPLUS_TOKEN=
# Loopback port saya reaches over the tailnet (1024-65535; default 8766).
CHATPLUS_PORT=8767

# Optional: the client's six-digit lock password, for its lock mode (idle
# timeout up to 24h). Leave empty to keep it off. It is a password: it stays only
# in .env (never committed) and is never printed or logged. Reads work while the
# client is locked; before a send the adapter enters it once on the lock screen.
CHATPLUS_LOCK_PASSWORD=